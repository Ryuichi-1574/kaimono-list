rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }
    function verified() {
      return signedIn() && request.auth.token.email_verified == true;
    }
    function isMember(hid) {
      return signedIn()
        && request.auth.uid in get(/databases/$(database)/documents/households/$(hid)).data.members;
    }

    // 世帯(家族グループ)
    match /households/{hid} {
      // 読み取り: メンバー本人、または招待されているメールアドレスでログインした人(参加画面で招待を探すため)
      allow read: if signedIn()
        && (request.auth.uid in resource.data.members
            || (verified() && request.auth.token.email in resource.data.invitedEmails));

      // 作成: 自分だけをメンバーにした世帯のみ
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['ownerUid', 'members', 'invitedEmails'])
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.members == [request.auth.uid];

      allow update: if signedIn() && (
        // オーナーが招待メールを変更する(メンバー・オーナーは変更不可)
        (resource.data.ownerUid == request.auth.uid
          && request.resource.data.ownerUid == resource.data.ownerUid
          && request.resource.data.members == resource.data.members)
        ||
        // 招待された本人が参加する(自分のuidを1つ追加し、自分のメールを招待から外すだけ)
        (verified()
          && request.auth.token.email in resource.data.invitedEmails
          && request.resource.data.ownerUid == resource.data.ownerUid
          && request.resource.data.members.hasAll(resource.data.members)
          && request.resource.data.members.size() == resource.data.members.size() + 1
          && request.auth.uid in request.resource.data.members
          && !(request.auth.token.email in request.resource.data.invitedEmails))
      );

      allow delete: if false;
    }

    // 世帯のデータ(リスト・カテゴリ・品目・購入履歴): メンバーだけが読み書きできる
    match /households/{hid}/{col}/{id} {
      allow read, write: if col in ['lists', 'categories', 'items', 'purchases']
        && isMember(hid);
    }

    // それ以外はすべて拒否
  }
}
